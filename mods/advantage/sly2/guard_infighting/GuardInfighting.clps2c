SR "[Guard Infighting] \n"
SR "comment=Guards fight with each other instead of the player\n"
SR "author=zami3333\n"

Set npcSwarmer 3E0774       // pal: 3E7F74
Set npcFlashlight 3E0780    // pal: 3E7F80
Set npcBear 3E07E0          // pal: 3E7FE0
Set nextSame 0x20
Set rageFlag 0x394
Set rageValue 0x398
W32 20893C 0 // dont write rageblind
Set rageBlind 0x3A8
W32 153F60 0 // dont fill enemies list
Set guardEnemyList 0x1110 // list of enemies for that guard

// Swarmers
    WP32 npcSwarmer,nextSame,nextSame,nextSame,nextSame,nextSame,nextSame,nextSame,nextSame,rageFlag 1
    WP32 npcSwarmer,nextSame,nextSame,nextSame,nextSame,nextSame,nextSame,nextSame,nextSame,rageValue 0x38
