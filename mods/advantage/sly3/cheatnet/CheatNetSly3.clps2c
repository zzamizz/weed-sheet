SR "gametitle=Sly 3: Honor Among Thieves (NTSC)\n\n"
SR "[CheatNet] \n"
SR "comment=Press R1+Select to open the menu.\n"
SR "author=zami3333\n"

Include "CheatNetSly3_Vars.clps2c"
Include "CheatNetSly3_Zac.clps2c"
Include "CheatNetSly3_General.clps2c"
Include "CheatNetSly3_Strings.clps2c"

SetEncoding UTF-16

// tofix: 
// - what is wrong with grapplecam
// - carmelita playabl

// The menu
    // Button combo (Select+R1)
    IF tnStatus =: 0xFFFF
        IF isPaused =. 0 && isGadgets =: 0xFFFF
            IF tnOpenP2 =. 0
                Call MenuCombo(pad_SelectR1)
                    W8 tnOpenP1 1
                    W8 openTN 1
                EI
            EI
            IF tnOpenP1 =. 0 && multiFlag =. 1
                Call MenuCombo(pad2_SelectR1)
                    W8 tnOpenP2 1
                    W8 openTN 1
                EI
            EI
        EI
    EI

// ThiefNet shortcuts
    If tnStatus !: 0xFFFF
        // Reload (L1)
        If pad_L1 =. 0xFF
            Call Reload(full)
        EI

        // Loading position (L3)
        IF pad_L3R3 =. 0xFD
            IF pad_R1 !. 0xFF 
                WP8 camera,reset 1
                W8 ccflag_zacTele 1
                W8 ccflag_zacCollider 1
                WF clockGame 0.01
                CB 34A380 34A370 0xC // save from cc into current
            EI
        EI

        // Saving position (R3)
        If pad_L3R3 =. 0xFB
            CB 34A370 34A380 0xC // save from current into cc
        EI

        // Warp to map centre (R1+L3)
        If pad_L3R3 =. 0xFD && pad_R1 =. 0xFF
            WF clockGame 0.01
            Call Teleport(0, 0, 2000)
        EI

        // Save initial position
        Call MapUptimeCheck()
            CB 34A370 34A380 0xC // save from current into cc
        EI
    EI

// Remove ThiefNet loading animation
    WP32 gui_ThiefNet,0x64 0
    WP32 gui_ThiefNet,0x68 0

// Reset some cheats during loading
    IF isLoading =. 2
        W8 ccflag_cheat11 0
        W8 ccflag_cheat17 0
        W8 ccflag_cheat28 0
    EI

// Keep music & ambience in ThiefNet
    IF tnStatus =: 0xFFFF
        W8 475058 3 // normal audio
    EI
    IF tnStatus !: 0xFFFF
        W8 475058 5 // audio in menu
    EI

// Disable buying prompt
    IF tnStatus !: 0xFFFF
        W32 tnBuying 0xFFFFFFFF // disable buying
        W8 tnMaxItems 24 // increase with how many cheats you add
    EI 

// Reset menu item index
    IF isLoading =. 2
        W32 tnHoverItem 0
    EI
    IF tnHoverItem =: 0xFFFF
        W32 tnHoverItem 0
    EI
    SR "\n"

// Sound effect swaps
    IF tnStatus =: 0xFFFF
        WP8 sfxPtr,0xA4 41 // sell sound
        WP8 sfxPtr,0xD4 53 // bass sound
        WP8 sfxPtr,0xD8 54 //error sound
    EI
    IF tnStatus !: 0xFFFF
        WP8 sfxPtr,0xA4 0x34
        WP8 sfxPtr,0xD4 0x28
        WP8 sfxPtr,0xD8 0x28
    EI

// Infinite scrolling (goofy)
    If tnHoverItem =. 0 && pad_DPadUp =. 0xFF && ccflag_InfScr1 =. 0
        W8 ccflag_InfScr1 1
        W8 tnHoverItem 0x17
        W8 tnScroll 0x12
    EI
    If pad_DPadUp !. 0xFF && ccflag_InfScr1 =. 1
        W8 ccflag_InfScr1 0
    EI

    If tnHoverItem =. 0x17 && pad_DPadDown =. 0xFF && ccflag_InfScr2 =. 0
        W8 ccflag_InfScr2 1
        W8 tnHoverItem 0x0
        W8 tnScroll 0x0
    EI
    If pad_DPadDown !. 0xFF && ccflag_InfScr2 =. 1
        W8 ccflag_InfScr2 0
    EI

// Fast scroll (Hold Circle)
    Call FastScroll(0x1, 0x6, 0x6)
    Call FastScroll(0x5, 0x0, 0x0)
    Call FastScroll(0x7, 0xC, 0xC)
    Call FastScroll(0xB, 0x6, 0x6)
    Call FastScroll(0xD, 0x12, 0x12)
    Call FastScroll(0x11, 0xC, 0xC)
    Call FastScroll(0x13, 0x18, 0x18)
    Call FastScroll(0x17, 0x12, 0x12)
    IF tnHoverItem =. 0x18 //fix backrooms glitch
        W8 tnHoverItem 0
        W8 tnScroll 0
    EI

// Multiplayer support
 //     //Write the "Player" string if multiplayer is enabled
 //         IF multiFlag =. 1
 //             WB playerString "00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 50 00 6C 00 61 00 79 00 65 00 72 00 20 00"
 //         EI
 // 
 //     // Give player 2 ThiefNet control
 //         IF tnOpenP2 =. 1
 //             W32 tnControl player2Pad
 //         EI
 // 
 //     // Check which player opens the menu, write appropriate player number
 //         IF multiFlag =. 1 && pad_SelectR1 =: 0xF7FE
 //             W8 playerNumString 0x31 // 1
 //         EI
 //         IF multiFlag =. 1 && pad2_SelectR1 =: 0xF7FE
 //             W8 playerNumString 0x32 // 2
 //         EI
 // 
 //     // Clear player flags by pressing triangle
 //         IF pad_Triangle =. 0xFF && tnOpenP1 =. 1
 //             W8 tnOpenP1 0
 //         EI
 //         IF pad2_Triangle =. 0xFF && tnOpenP2 =. 1
 //             W8 tnOpenP2 0
 //             W32 tnControl player1Pad
 //         EI

// Populate buy menu with gadget IDs (cheats)
    W32 46F86C 6 // Trigger Bomb // Reload as Sly                
    W32 46F874 7 // Fishing // Reload as Bentley            
    W32 46F87C 8 // Alarm Clock // Reload as Murray             
    W32 46F884 9 // Adrenaline // Reload as -- (Special character)                       
    W32 46F88C 10 // Health Extract // Map               
    W32 46F894 11 // Hover // Infinite Jumps                          
    W32 46F89C 12 // Insanity // Warp                         
    W32 46F8A4 13 // Grapple // X-Ray
    W32 46F8AC 14 // Size Destab // Flyable Glider         
    W32 46F8B4 15 // Rage Bomb // Undetectable         
    W32 46F8BC 16 // Reduct // Godmode         
    W32 46F8C4 17 // Ball // Damage Type         
    W32 46F8CC 18 // Berserker // Infinite HP+MP         
    W32 46F8D4 19 // Juggernaut // SUPERHOT         
    W32 46F8DC 20 // Guttural // Max Draw Distance         
    W32 46F8E4 21 // Fists of flame // Claustrophobia         
    W32 46F8EC 22 // Temporal // Despawn All Guards         
    W32 46F8F4 23 // Raging Inferno // Chase         
    W32 46F8FC 24 // Diablo Fire // Toggle Guard AI         
    W32 46F904 25 // Smoke Bomb // Dance Break    
    W32 46F90C 26 // Combat Doge // Crash     
    W32 46F914 27 // Paraglide // Time         
    W32 46F91C 28 // Silent Obl // Toggle Skybox         
    W32 46F924 29 // Feral // Hide Flash         
    W32 46F92C 30 // Mega Jump // 
    W32 46F934 31 // Knockout // 
    W32 46F93C 32 // Shadow 1 // 
    W32 46F944 33 // Thief Reflex // 
    W32 46F94C 34 // Shadow 2 // 
    W32 46F954 35 // Rocket // 
    W32 46F95C 36 // Treasure // 
    W32 46F964 37 // ENGLISH // 
    W32 46F96C 38 // Venice // 
    W32 46F974 39 // Photo // 
    W32 46F97C 40 // Pirate // 
    W32 46F984 41 // Spin 1 // 
    W32 46F98C 42 // Spin 2 // 
    W32 46F994 43 // Spin 3 // 
    W32 46F99C 44 // Jump 1 // 
    W32 46F9A4 45 // Jump 2 // 
    W32 46F9AC 46 // Jump 3 // 
    W32 46F9B4 47 // Push 1 // 
    W32 46F9BC 48 // Push 2 // 
    W32 46F9C4 49 // Push 3 // 

// Remove character icons from gadgets
    W32 343498 25 // Murray
    W32 3434D4 25
    W32 343510 25
    W32 34354C 25
    W32 343588 25
    W32 3435C4 25
    W32 343600 25
    W32 34363C 25

// ThiefNet visual changes
    IF tnStatus !: 0xFFFF

        // Remove ThiefNet parts completely
        WP32 46F844,0xB4,0x8A4 0 // blue bg
        WP32 46F844,0xB4,0xAB4 0 // menu border
        WP32 46F844,0xB4,0xB44 0 // menu bg
        WP32 46F844,0xB4,0xC34 0 // coin bg
        WP32 46F844,0xB4,0xCC4 0 // coin
        WP32 46F844,0xB4,0xD84 0 // green arrow
        WP32 46F844,0xB4,0xF04 0 // side arrows
        WP32 46F844,0xB4,0x1024 0 // bentley icon shadow
        WP32 46F844,0xB4,0x1054 0 // bentley icon
        WP32 46F844,0xB4,0xF94 0 // sly icon shadow
        WP32 46F844,0xB4,0xFC4 0 // sly icon
        WP32 46F844,0xB4,0x10B4 0 // mur icon shadow
        WP32 46F844,0xB4,0x10E4 0 // mur icon
        WP32 46F844,0xB4,0x1474 0 // orange buying effect

        // Text scales and positions
        WF 47FAE0 30 // buy gadgets text x position
        WF 47FA80 289 // description x
        WF 47FA84 350.95 // description y
        W32 47B024 0xFFE0CCA0 // description color
        WF 47FA70 0.85 // desc scale x
        WF 47FA80 245 // desc pos X
        WF 47FA84 355 // desc pos Y
        WF 47FA7C 0.85 // desc scale y
        WF 47FAE4 42 // cheatnet text y
        W32 47B204 0xFFE0CCA0 // cheatnet text color
        W32 47B084 0x44D0BC90  //coin text color 
        W32 47B080 1449  //coin text var
        W32 47B094 0 //coin text anchor left 
        WF 47B088 30  //coin text scale 
        WF 47FAA0 0.60  //coin text scale x 
        WF 47FAAC 0.60  //coin text scale y 
        WF 47FAB0 188  //coin text x 
        WF 47FAB4 394  //coin text y 
        WF 47FB90 502 // selector bar x scale
        WF 47FBA4 143 // selector bar y scale
        WF 47FBA0 4444 // selector bar x pos (fixes for 16:9)
        W32 47C7A0 0x44D0BC90 // selector color
        WF 47FE10 45 // gadget item x
        WF 47FE40 45 // gadget item x
        WF 47FEA0 45 // gadget item x
        WF 47FED0 45 // gadget item x
        WF 47FF00 45 // gadget item x
        WF 47FF30 45 // gadget item x
        WF 47FF50 0 // price scale
        WF 47FFE0 0 // price scale
        WF 47FFB0 0 // price scale
        WF 480010 0 // price scale
        WF 47FE60 0 // price scale
        WF 47FF80 0 // price scale
        WF 480040 0 // gadget description scale
        WF 480070 0 // "available gadgets" scale

    Function HighlightCheck(check, index, value, value2)
        IF 484F66 =. check //if selector is 1-6
            W32 index value //make selector bright/transparent
        EI
        IF 484F66 !. check //if selector is 1-6
            W32 index value2 //make selector bright/transparent
        EI
    EndFunction
    Call HighlightCheck(0x0D, 47B684, 0xFFF0DCB0, 0x44D0BC90)
    Call HighlightCheck(0x35, 47B6B4, 0xFFF0DCB0, 0x44D0BC90)
    Call HighlightCheck(0x5D, 47B714, 0xFFF0DCB0, 0x44D0BC90)
    Call HighlightCheck(0x82, 47B744, 0xFFF0DCB0, 0x44D0BC90)
    Call HighlightCheck(0x96, 47B774, 0xFFF0DCB0, 0x44D0BC90)
    Call HighlightCheck(0xAA, 47B7A4, 0xFFF0DCB0, 0x44D0BC90)
    EI

Function RespawnAsCharacter(charid, cheat)
    IF 36F7C2 =: 0xFF7F && ccflag_forceOnce =. 1 && cheat =. 1
        W32 actID charid 
        W32 mapSpawn 0xAE87
        Call Reload(soft)
        W8 cheat 0
        W8 ccflag_forceOnce 0
    EI
    IF cheat =. 1
        IF ccflag_forceOnce =. 0
            W32 force_Triangle 0x7F7FFFFF
            W8 ccflag_forceOnce 1
        EI
    EI
EndFunction

// ID 6: Respawn as Sly
    Call RespawnAsCharacter(24, ccflag_cheat6)
    Call CheatToggle(0x0, ccflag_cheat6, ccflag_cheat6tgl)

// ID 7: Respawn as Bentley
    Call RespawnAsCharacter(25, ccflag_cheat7)
    Call CheatToggle(0x1, ccflag_cheat7, ccflag_cheat7tgl)

// ID 8: Respawn as Murray
    Call RespawnAsCharacter(26, ccflag_cheat8)
    Call CheatToggle(0x2, ccflag_cheat8, ccflag_cheat8tgl)

// ID 9: Respawn as Special characters  // TODO - figure out how to spawn carmelita
    IF mapID =. map_AustraliaHub
        IF ccflag_charScroll =. 0 
            WS specialCharString "Guru\0"
            IF pad_Cross =. 0xFF
                Call RespawnAsCharacter(29, ccflag_cheat9)
            EI
        EI
        IF ccflag_charScroll >. 0
            W8 ccflag_charScroll 0
        EI
    EI
    IF mapID =. map_HollandHub
        IF ccflag_charScroll =. 0 
            WS specialCharString "Guru\0"
            IF pad_Cross =. 0xFF
                Call RespawnAsCharacter(29, ccflag_cheat9)
            EI
        EI
        IF ccflag_charScroll >. 0
            W8 ccflag_charScroll 0
        EI
    EI
    IF mapID =. map_ChinaHub
        IF ccflag_charScroll =. 0 
            WS specialCharString "Guru\0"
            IF pad_Cross =. 0xFF
                Call RespawnAsCharacter(29, ccflag_cheat9)
            EI
        EI
        IF ccflag_charScroll =. 1
            WS specialCharString "Panda King\0"
            IF pad_Cross =. 0xFF
                Call RespawnAsCharacter(30, ccflag_cheat9)
            EI
        EI
        IF ccflag_charScroll =. 2
            WS specialCharString "Penelope\0"
            IF pad_Cross =. 0xFF
                Call RespawnAsCharacter(31, ccflag_cheat9)
            EI
        EI
        IF ccflag_charScroll >. 3
            W8 ccflag_charScroll 0
        EI
    EI
    IF mapID =. map_PirateHub
        IF ccflag_charScroll =. 0
            WS specialCharString "Penelope\0"
            IF pad_Cross =. 0xFF
                Call RespawnAsCharacter(31, ccflag_cheat9)
            EI
        EI
        IF ccflag_charScroll =. 0
            WS specialCharString "RC Car\0"
            IF pad_Cross =. 0xFF
                Call RespawnAsCharacter(15063, ccflag_cheat9) 
            EI
        EI
        IF ccflag_charScroll >. 2
            W8 ccflag_charScroll 0
        EI
    EI
    IF tnHoverItem =. 3
        IF ccflag_scroll2Temp =. 0 && pad_DPadRight =. 0xFF
            W8 ccflag_scroll2Temp 1
            I8 ccflag_charScroll 1
        EI
        IF pad_DPadRight !. 0xFF && ccflag_scroll2Temp =. 1
            W8 ccflag_scroll2Temp 0
        EI
        IF ccflag_scroll5Temp =. 0 && pad_DPadLeft =. 0xFF && ccflag_charScroll !. 0
            W8 ccflag_scroll5Temp 1
            D8 ccflag_charScroll 1
        EI
        IF pad_DPadLeft !. 0xFF && ccflag_scroll5Temp =. 1
            W8 ccflag_scroll5Temp 0
        EI
    EI
    Call CheatToggle(0x3, ccflag_cheat9, ccflag_cheat9tgl)

// ID 10: Map
    Call ShowCurrentMap(2, 0)       // Hazard Room
    Call ShowCurrentMap(3, 1)       // Venice Hub
    Call ShowCurrentMap(4, 2)       // Canal
    Call ShowCurrentMap(5, 3)       // Coffeehouses
    Call ShowCurrentMap(6, 4)       // Opera House
    Call ShowCurrentMap(7, 5)       // Police HQ
    Call ShowCurrentMap(8, 6)       // Outback Hub
    Call ShowCurrentMap(9, 7)       // Ayer's Rock
    Call ShowCurrentMap(10, 8)      // Oil Field
    Call ShowCurrentMap(11, 9)      // Cave (Sly)
    Call ShowCurrentMap(12, 10)     // Cave (Guru)
    Call ShowCurrentMap(13, 11)     // Lemonade Bar
    Call ShowCurrentMap(14, 12)     // Cave (Murray)
    Call ShowCurrentMap(15, 13)     // Holland Hub
    Call ShowCurrentMap(16, 14)     // Hotel
    Call ShowCurrentMap(17, 15)     // Hangar (Team Iceland)
    Call ShowCurrentMap(18, 16)     // Hangar (Team Black Baron)
    Call ShowCurrentMap(19, 17)     // Hangar (Team Cooper)
    Call ShowCurrentMap(20, 18)     // Sewers
    Call ShowCurrentMap(21, 19)     // Dogfight / Biplane Battlefield
    Call ShowCurrentMap(23, 20)     // China Hub
    Call ShowCurrentMap(24, 21)     // China Intro
    Call ShowCurrentMap(25, 22)     // Flashback Arena
    Call ShowCurrentMap(26, 23)     // Tsao's Battleground
    Call ShowCurrentMap(27, 24)     // Panda King Apartment
    Call ShowCurrentMap(28, 25)     // Grapplecam Hall
    Call ShowCurrentMap(29, 26)     // Tsao's Palace
    Call ShowCurrentMap(30, 27)     // Tsao's Treasure Temple
    Call ShowCurrentMap(31, 28)     // Pirate Hub
    Call ShowCurrentMap(32, 29)     // Sailing Map
    Call ShowCurrentMap(33, 30)     // Underwater
    Call ShowCurrentMap(34, 31)     // Dagger Island
    Call ShowCurrentMap(35, 32)     // Kaine Island
    Call ShowCurrentMap(36, 33)     // Underwater Tunnel
    Call ShowCurrentMap(37, 34)     // Vault (Entrance)
    Call ShowCurrentMap(38, 35)     // Vault (Gauntlet)
    Call ShowCurrentMap(39, 36)     // Dr. M's Arena

    IF tnStatus !: 0xFFFF
        Call LoadMap(0, " Hazard Room\0", 2EE058)
        Call LoadMap(1, " Venice Hub\0", 2EE098)
        Call LoadMap(2, " Canal\0", 2EE0D8)
        Call LoadMap(3, " Coffeehouse\0", 2EE118)
        Call LoadMap(4, " Opera House\0", 2EE158)
        Call LoadMap(5, " Police HQ\0", 2EE198)
        Call LoadMap(6, " Outback Hub\0", 2EE1D8)
        Call LoadMap(7, " Ayer's Rock\0", 2EE218)
        Call LoadMap(8, " Oil Field\0", 2EE258)
        Call LoadMap(9, " Cave (Sly)\0", 2EE298)
        Call LoadMap(10, " Cave (Guru)\0", 2EE2D8)
        Call LoadMap(11, " Lemonade Bar\0", 2EE318)
        Call LoadMap(12, " Cave (Murray)\0", 2EE358)
        Call LoadMap(13, " Holland Hub\0", 2EE398)
        Call LoadMap(14, " Hotel\0", 2EE3D8)
        Call LoadMap(15, " Iceland Hangar\0", 2EE418)
        Call LoadMap(16, " Baron Hangar\0", 2EE458)
        Call LoadMap(17, " Cooper Hangar\0", 2EE498)
        Call LoadMap(18, " Sewers\0", 2EE4D8)
        Call LoadMap(19, " Biplane Arena\0", 2EE518)
        Call LoadMap(20, " China Hub\0", 2EE598)
        Call LoadMap(21, " China Intro\0", 2EE5D8)
        Call LoadMap(22, " Flashback Arena\0", 2EE618)
        Call LoadMap(23, " Tsao Arena\0", 2EE658)
        Call LoadMap(24, " Panda's Apartment\0", 2EE698)
        Call LoadMap(25, " Grapplecam Hall\0", 2EE6D8)
        Call LoadMap(26, " Tsao's Palace\0", 2EE718)
        Call LoadMap(27, " Tsao's Temple\0", 2EE758)
        Call LoadMap(28, " Pirate Hub\0", 2EE798)
        Call LoadMap(29, " Sailing Map\0", 2EE7D8)
        Call LoadMap(30, " Underwater\0", 2EE818)
        Call LoadMap(31, " Dagger Island\0", 2EE858)
        Call LoadMap(32, " Kaine Island\0", 2EE898)
        Call LoadMap(33, " Underwater Tunnel\0", 2EE8D8)
        Call LoadMap(34, " Vault Entrance\0", 2EE918)
        Call LoadMap(35, " Gauntlet\0", 2EE958)
        Call LoadMap(36, " Dr. M's Arena\0", 2EE998)
    EI

    IF tnHoverItem =. 4
        IF ccflag_mapNum >. 36 // scroll up to 36
            W8 ccflag_mapNum 0
        EI


        If pad_DPadRight =. 0xFF
            If ccflag_mapScrollOnce =. 0
                W8 ccflag_mapScrollOnce 1
                I8 ccflag_mapNum 1
            EI
        EI
        If pad_DPadRight !. 0xFF
            IF ccflag_mapScrollOnce =. 1
                W8 ccflag_mapScrollOnce 0
            EI
        EI

        If pad_DPadLeft =. 0xFF && ccflag_mapNum !. 0
            If ccflag_mapScrollOnce2 =. 0
                W8 ccflag_mapScrollOnce2 1
                D8 ccflag_mapNum 1
            EI
        EI
        If pad_DPadLeft !. 0xFF
            IF ccflag_mapScrollOnce2 =. 1
                W8 ccflag_mapScrollOnce2 0
            EI
        EI

        IF pad_DPadLeft =. 0xFF && ccflag_mapNum =. 0
            W8 ccflag_mapNum 36
        EI

        IF pad_Cross =. 0xFF
            Call Reload(full)
        EI
    EI

    Call CheatToggle(0x4, ccflag_cheat10, ccflag_cheat10tgl)

// ID 11: Infinite Jumps
  // TODO - add better method, with horizontal movement
    IF ccflag_cheat11 =. 1
        WP32 actChar,infJumps 0
    EI
    Call CheatToggle(0x5, ccflag_cheat11, ccflag_cheat11tgl)
    Call ToggleMask(infJumpStringEnd, ccflag_cheat11)

// ID 12: Warps
    Call MapUptimeCheck()
        WS warpCharString " --\0"
    EI

    IF tnHoverItem =. 0x6
        IF ccflag_warpTemp =. 0 && pad_DPadRight =. 0xFF
            W8 ccflag_warpTemp 1
            I8 ccflag_warpScroll 1
        EI
        IF pad_DPadRight !. 0xFF && ccflag_warpTemp =. 1
            W8 ccflag_warpTemp 0
        EI

        IF ccflag_warpTemp2 =. 0 && pad_DPadLeft =. 0xFF
            W8 ccflag_warpTemp2 1
            D8 ccflag_warpScroll 1
        EI
        IF pad_DPadLeft !. 0xFF && ccflag_warpTemp2 =. 1
            W8 ccflag_warpTemp2 0
        EI
        
        Call FillWarps(" World Origin\0", 0, 0, 0, 0)
        IF tnStatus !: 0xFFFF
            IF pad_DPadLeft =. 0xFF && ccflag_warpScroll =. 0
                CB currentMaxWarp ccflag_warpScroll 1 
            EI

            IF pad_DPadRight =. 0xFF && ccflag_warpTemp =. 0
                W8 ccflag_warpScroll 0
            EI

            IF mapID =. map_Hazard
                // Hazard Room
                Call SetMaxWarps(map_Hazard, 3)
                Call FillWarps(" Center\0", 1, 3550, 440, 100)
                Call FillWarps(" Top\0", 2, 3580, 630, 3440)
                Call FillWarps(" Safehouse\0", 3, 6640, 680, 90)
            EI
            IF mapID =. map_VeniceHub
                // Venice Hub
                Call SetMaxWarps(map_VeniceHub, 7)
                Call FillWarps(" Safehouse\0", 1, 200, -2090, 173)
                Call FillWarps(" Safehouse Roof\0", 2, 863, -1420, 1266)
                Call FillWarps(" Dome\0", 3, -7570, 1670, 1962)
                Call FillWarps(" Ferris\0", 4, 6900, 1480, 160)
                Call FillWarps(" Opera\0", 5, 6250, 8210, 260)
                Call FillWarps(" Fountain\0", 6, -6670, 8550, 700)
                Call FillWarps(" Aquarium\0", 7, 8040, -4365, 160)
            EI
            IF mapID =. map_Canal
                // Canal
                Call SetMaxWarps(map_Canal, 3)
                Call FillWarps(" Boat\0", 1, 0, 0, 130)
                Call FillWarps(" Intersection 1\0", 2, 665, -12555, 140)
                Call FillWarps(" Intersection 2\0", 3, 27250, 28580, 140)
            EI
            IF mapID =. map_Coffee
                // Coffee
                Call SetMaxWarps(map_Coffee, 7)
                Call FillWarps(" Entrance 1\0", 1, 710, -5000, 125)
                Call FillWarps(" Entrance 2\0", 2, 1070, 100, 125)
                Call FillWarps(" Entrance 3\0", 3, 1160, 5000, 125)
                Call FillWarps(" Safe 1\0", 4, -1710, -4990, 125)
                Call FillWarps(" Safe 2\0", 5, -1750, 10, 125)
                Call FillWarps(" Safe 3\0", 6, 3245, 4990, 125)
                Call FillWarps(" Roof\0", 7, -1780, -4540, 1175)
            EI
            IF mapID =. map_OperaHouse
                // Opera
                Call SetMaxWarps(map_OperaHouse, 6)
                Call FillWarps(" Entrance\0", 1, -7130, -11340, 1030)
