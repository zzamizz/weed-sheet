                // vault gauntlet
                Call SetMaxWarps(map_Gauntlet, 11)
                Call FillWarps(" Slytunkhamen\0", 1, -28690, 21665, -2175)
                Call FillWarps(" Sir Galleth\0", 2, -24715, 13995, -2260)
                Call FillWarps(" Salim\0", 3, -13760, 12485, -2200)
                Call FillWarps(" Slaigh\0", 4, -15325, 24680, -2190)
                Call FillWarps(" Rioichi\0", 5, -21130, 19955, -180)
                Call FillWarps(" Henriette\0", 6, -10530, 13200, 120)
                Call FillWarps(" Tennesee\0", 7, 2010, 13275, -2280)
                Call FillWarps(" Thaddeus\0", 8, 9360, 1820, -2185)
                Call FillWarps(" Otto\0", 9, -2050, 2740, 0)
                Call FillWarps(" Conner\0", 10, 7515, 5030, 150)
                Call FillWarps(" Inner Sanctum\0", 11, 16645, -2260, 120)
            EI
        EI
    EI

// ID 13: X-Ray
 // TODO - increase sly's brightness or smth
    IF ccflag_cheat13 =. 1
        WF 479350 0.23
    EI
    IF ccflag_cheat13 =. 0
        WF 479350 1
    EI
    Call CheatToggle(0x7, ccflag_cheat13, ccflag_cheat13tgl)
    Call ToggleMask(slipperyStringEnd, ccflag_cheat13)

// ID 14: Flyable Glider
    If ccflag_cheat14 =. 1 //cheat on
        WF 323110 2000 // pull fly speed
        WF 323114 2000 // push fly speed
        WF 323118 -800 // pull vertical speed
        WF 32311C 800 // push vertical speed
    EI

    If ccflag_cheat14 =. 0 //cheat on
        WF 323110 300 // pull fly speed
        WF 323114 800 // push fly speed
        WF 323118 -200 // pull vertical speed
        WF 32311C -400  // push vertical speed
    EI
    Call CheatToggle(0x8, ccflag_cheat14, ccflag_cheat14tgl)
    Call ToggleMask(flyableStringEnd, ccflag_cheat14)

// ID 15: Undetectable
    IF ccflag_cheat15 =. 1
        WP32 actChar,undetectable 1
    EI
    IF ccflag_cheat15 =. 0
        WP32 actChar,undetectable 0
    EI
    Call CheatToggle(0x9, ccflag_cheat15, ccflag_cheat15tgl)
    Call ToggleMask(undetectableStringEnd, ccflag_cheat15)

// ID 16: Godmode
    IF ccflag_cheat16 =. 1
        WP32 actChar,godmode 1
        
        // death barriers
        WPF 478588,C0 0 // X scale
        WPF 478BF0,20,1E0 0
        WPF 478588,A4 0 // Y scale
        WPF 478588,A8 0
        WPF 478BF0,20,1F4 0
        WPF 478BF0,20,1F8 0
        WPF 478588,B8 0 // Z scale
        WPF 478BF0,20,208 0
    EI
    IF ccflag_cheat16 =. 0
        WP32 actChar,godmode 0
    EI
    Call CheatToggle(0xA, ccflag_cheat16, ccflag_cheat16tgl)
    Call ToggleMask(godmodeStringEnd, ccflag_cheat16)

// ID 17: Damage Type
    Call MapUptimeCheck()
        WS damageCharString " Normal\0"
    EI

    IF tnHoverItem =. 0xB
        IF ccflag_dmgScroll >. 8 // scroll up to 8
            W8 ccflag_dmgScroll 0
        EI

        IF ccflag_scrollTemp2 =. 0 && pad_DPadRight =. 0xFF
            W8 ccflag_scrollTemp2 1
            I8 ccflag_dmgScroll 1
        EI
        IF pad_DPadRight !. 0xFF && ccflag_scrollTemp2 =. 1
            W8 ccflag_scrollTemp2 0
        EI

        IF ccflag_scrollTemp3 =. 0 && pad_DPadLeft =. 0xFF
            W8 ccflag_scrollTemp3 1
            D8 ccflag_dmgScroll 1
        EI
        IF pad_DPadLeft !. 0xFF && ccflag_scrollTemp3 =. 1
            W8 ccflag_scrollTemp3 0
        EI

        IF pad_DPadLeft =. 0xFF && ccflag_dmgScroll =. 0
            W8 ccflag_dmgScroll 8
        EI
    EI

    IF ccflag_dmgScroll =. 0 // Normal
    // this makes triangle attacks for sly mur broken
        WS damageCharString " Normal\0"
        Call DamageType(sly, 0x11FC, type_Knockout)
        Call DamageType(sly, 0x12CC, type_Normal2)
        Call DamageType(sly, 0x146C, type_Normal)
        Call DamageType(bentley, 0x1BC, type_Normal)
        Call DamageType(murray, 0xAAC, type_Normal)
        Call DamageType(murray, 0x9DC, type_Normal2)
    EI
    IF ccflag_dmgScroll =. 1 // Fire
        WS damageCharString " Fire\0"
        Call DamageType(sly, 0x11FC, type_Fire)
        Call DamageType(sly, 0x12CC, type_Fire)
        Call DamageType(sly, 0x146C, type_Fire)
        Call DamageType(bentley, 0x1BC, type_Fire)
        Call DamageType(murray, 0xAAC, type_Fire)
        Call DamageType(murray, 0x9DC, type_Fire)
    EI
    IF ccflag_dmgScroll =. 2 // Electric
        WS damageCharString " Electric\0"
        Call DamageType(sly, 0x11FC, type_Electric)
        Call DamageType(sly, 0x12CC, type_Electric)
        Call DamageType(sly, 0x146C, type_Electric)
        Call DamageType(bentley, 0x1BC, type_Electric)
        Call DamageType(murray, 0xAAC, type_Electric)
        Call DamageType(murray, 0x9DC, type_Electric)
    EI
    IF ccflag_dmgScroll =. 3 // Knockout
        WS damageCharString " Knockout\0"
        Call DamageType(sly, 0x11FC, type_Knockout)
        Call DamageType(sly, 0x12CC, type_Knockout)
        Call DamageType(sly, 0x146C, type_Knockout)
        Call DamageType(bentley, 0x1BC, type_Knockout)
        Call DamageType(murray, 0xAAC, type_Knockout)
        Call DamageType(murray, 0x9DC, type_Knockout)
    EI
    IF ccflag_dmgScroll =. 4 // Void
        WS damageCharString " Void\0"
        Call DamageType(sly, 0x11FC, type_Void)
        Call DamageType(sly, 0x12CC, type_Void)
        Call DamageType(sly, 0x146C, type_Void)
        Call DamageType(bentley, 0x1BC, type_Void)
        Call DamageType(murray, 0xAAC, type_Void)
        Call DamageType(murray, 0x9DC, type_Void)
    EI
    IF ccflag_dmgScroll =. 5 // Sleep
        WS damageCharString " Sleep\0"
        Call Damage(sly, 0x11F8, 0x32)
        Call Damage(sly, 0x12C8, 0x32)
        Call Damage(sly, 0x1468, 0x32)
        Call Damage(bentley, 0x1B8, 0x32)
        Call Damage(murray, 0x9D8, 0x32)
        Call Damage(murray, 0xAA8, 0x32)
        Call DamageType(sly, 0x11FC, type_Sleep)
        Call DamageType(sly, 0x12CC, type_Sleep)
        Call DamageType(sly, 0x146C, type_Sleep)
        Call DamageType(bentley, 0x1BC, type_Sleep)
        Call DamageType(murray, 0xAAC, type_Sleep)
        Call DamageType(murray, 0x9DC, type_Sleep)
    EI
    IF ccflag_dmgScroll !. 5 //restore damage
        Call Damage(sly, 0x11F8, 0x9)
        Call Damage(sly, 0x12C8, 0xA)
        Call Damage(sly, 0x1468, 0xA)
        Call Damage(bentley, 0x1B8, 0xA)
        Call Damage(murray, 0x9D8, 0xA)
        Call Damage(murray, 0xAA8, 0xA)
    EI
    IF ccflag_dmgScroll =. 6 // Shrink
        WS damageCharString " Shrink\0"
        Call DamageType(sly, 0x11FC, type_Shrink)
        Call DamageType(sly, 0x12CC, type_Shrink)
        Call DamageType(sly, 0x146C, type_Shrink)
        Call DamageType(bentley, 0x1BC, type_Shrink)
        Call DamageType(murray, 0xAAC, type_Shrink)
        Call DamageType(murray, 0x9DC, type_Shrink)
    EI
    IF ccflag_dmgScroll =. 7 // Rage
        WS damageCharString " Rage\0"
        Call DamageType(sly, 0x11FC, type_Rage)
        Call DamageType(sly, 0x12CC, type_Rage)
        Call DamageType(sly, 0x146C, type_Rage)
        Call DamageType(bentley, 0x1BC, type_Rage)
        Call DamageType(murray, 0xAAC, type_Rage)
        Call DamageType(murray, 0x9DC, type_Rage)
    EI
    IF ccflag_dmgScroll =. 8 // Instakill
        WS damageCharString " Instakill\0"
        Call DamageType(sly, 0x11FC, type_Instakill)
        Call DamageType(sly, 0x12CC, type_Instakill)
        Call DamageType(sly, 0x146C, type_Instakill)
        Call DamageType(bentley, 0x1BC, type_Instakill)
        Call DamageType(murray, 0xAAC, type_Instakill)
        Call DamageType(murray, 0x9DC, type_Instakill)
    EI
    Call CheatToggle(0xB, ccflag_cheat17, ccflag_cheat17tgl)

// ID 18: Infinite HP+MP
    IF ccflag_cheat18 =. 1
        IF actID !. 26
            WP32 actChar,health 40
        EI
        IF actID =. 26
            WP32 actChar,health 60
        EI
        WP32 actChar,gadgetpower 100
    EI
    Call CheatToggle(0xC, ccflag_cheat18, ccflag_cheat18tgl)
    Call ToggleMask(infMPStringEnd, ccflag_cheat18)

// ID 19: SUPERHOT
    IF ccflag_cheat19 =. 1 && tnStatus =: 0xFFFF
        CB pad_LS clockGame 4
        W8 475058 5
    EI
    IF pad_Triangle =. 0xFF && ccflag_cheat19 =. 0 && tnStatus =: 0xFFFF
        WF clockGame 1
        W8 475058 3
    EI
    Call CheatToggle(0xD, ccflag_cheat19, ccflag_cheat19tgl)
    Call ToggleMask(superhotStringEnd, ccflag_cheat19)

// ID 20: Max Draw Distance
    IF ccflag_cheat20 =. 1
        WPF camera,setDrawDist -9
        WPF camera,currentDrawDist -9
    EI
    IF ccflag_cheat20 =. 0 && pad_Triangle =. 0xFF
        WPF camera,setDrawDist 1
        WPF camera,currentDrawDist 1
    EI
    Call CheatToggle(0xE, ccflag_cheat20, ccflag_cheat20tgl)
    Call ToggleMask(maxdrawStringEnd, ccflag_cheat20)

// ID 21: Claustrophobia
    IF ccflag_cheat21 =. 1
        WPF camera,claustro 0.03
    EI
    // instead of saving & returning original camera stretch, reopening the binoc sets it automatically
    Call CheatToggle(0xF, ccflag_cheat21, ccflag_cheat21tgl)
    Call ToggleMask(clausStringEnd, ccflag_cheat21)

Function TouchPeople(map, entity, poolindex, offsets, value)
    IF mapID =. map
        WP32 fkx,entity,poolindex,offsets value
    EI
EndFunction

Function TouchVenice(offsets, value)
    Call TouchPeople(map_VeniceHub, v_doberman, 0, offsets, value)
    Call TouchPeople(map_VeniceHub, v_doberman, 4, offsets, value)
    Call TouchPeople(map_VeniceHub, v_ectoswarmer, 0, offsets, value)
    Call TouchPeople(map_VeniceHub, v_ectoswarmer, 4, offsets, value)
    Call TouchPeople(map_VeniceHub, v_ectoswarmer, 8, offsets, value)
    Call TouchPeople(map_VeniceHub, v_endoswarmer, 0, offsets, value)
    Call TouchPeople(map_VeniceHub, v_endoswarmer, 4, offsets, value)
    Call TouchPeople(map_VeniceHub, v_endoswarmer, 8, offsets, value)
EndFunction

Function TouchOpera(offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, 0, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, 4, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, 8, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, C, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, 10, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, 14, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, 18, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_ectoswarmer, 1C, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_endoswarmer, 0, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_endoswarmer, 4, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_endoswarmer, 8, offsets, value)
    Call TouchPeople(map_OperaHouse, opera_endoswarmer, C, offsets, value)
