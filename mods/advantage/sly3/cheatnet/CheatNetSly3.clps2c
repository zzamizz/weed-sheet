// ID 22: Despawn All Guards
    IF tnHoverItem =. 16
        IF ccflag_cheat22 =. 1
            Call TouchVenice(despawn, 4)
            Call TouchOpera(despawn, 4)
            Call TouchOutback(despawn, 4)
            Call TouchCaveSly(despawn, 4)
            Call TouchCaveMur(despawn, 4)
            Call TouchHolland(despawn, 4)
            Call TouchChina(despawn, 4)
            Call TouchPirate(despawn, 4)
            Call TouchDagger(despawn, 4)
            Call TouchPeople(map_VeniceHub, v_carmelita, 0, despawn, 4)
            Call TouchPeople(map_HollandHub, h_carmelita, 0, despawn, 4)
            Call TouchPeople(map_ChinaHub, c_carmelita, 0, despawn, 4)
            WF clockGame 0.01

            IF pad_Cross =. 0
                W8 ccflag_cheat22 0
            EI
        EI
        IF ccflag_cheat22 =. 0
            Call TouchVenice(despawn, 0)
            Call TouchOpera(despawn, 0)
            Call TouchOutback(despawn, 0)
            Call TouchCaveSly(despawn, 0)
            Call TouchCaveMur(despawn, 0)
            Call TouchHolland(despawn, 0)
            Call TouchChina(despawn, 0)
            Call TouchPirate(despawn, 0)
            Call TouchDagger(despawn, 0)
            Call TouchPeople(map_VeniceHub, v_carmelita, 0, despawn, 0)
            Call TouchPeople(map_HollandHub, h_carmelita, 0, despawn, 0)
            Call TouchPeople(map_ChinaHub, c_carmelita, 0, despawn, 0)
        EI
    EI
    Call CheatToggle(0x10, ccflag_cheat22, ccflag_cheat22tgl)

// ID 23: Chase
    IF tnHoverItem =. 17
        IF ccflag_cheat23 =. 1
            Call TouchVenice(slychase, 1)
            Call TouchVenice(murraychase, 1)
            Call TouchVenice(bentleychase, 1)
            Call TouchOpera(slychase, 1)
            Call TouchOpera(murraychase, 1)
            Call TouchOpera(bentleychase, 1)
            Call TouchOutback(slychase, 1)
            Call TouchOutback(murraychase, 1)
            Call TouchOutback(bentleychase, 1)
            Call TouchCaveSly(slychase, 1)
            Call TouchCaveSly(murraychase, 1)
            Call TouchCaveSly(bentleychase, 1)
            Call TouchCaveMur(slychase, 1)
            Call TouchCaveMur(murraychase, 1)
            Call TouchCaveMur(bentleychase, 1)
            Call TouchHolland(slychase, 1)
            Call TouchHolland(murraychase, 1)
            Call TouchHolland(bentleychase, 1)
            Call TouchChina(slychase, 1)
            Call TouchChina(murraychase, 1)
            Call TouchChina(bentleychase, 1)
            Call TouchPirate(slychase, 1)
            Call TouchPirate(murraychase, 1)
            Call TouchPirate(bentleychase, 1)
            Call TouchDagger(slychase, 1)
            Call TouchDagger(murraychase, 1)
            Call TouchDagger(bentleychase, 1)
            Call TouchPeople(map_VeniceHub, v_carmelita, 0, carmChase, 1)
            Call TouchPeople(map_HollandHub, h_carmelita, 0, carmChase, 1)
            Call TouchPeople(map_ChinaHub, c_carmelita, 0, carmChase, 1)
            WF clockGame 0.01

            IF pad_Cross =. 0
                W8 ccflag_cheat23 0
            EI            
        EI
    EI
    IF tnHoverItem !. 17
        W8 ccflag_cheat23 0
    EI
    Call CheatToggle(0x11, ccflag_cheat23, ccflag_cheat23tgl)

// ID 24: Disable Guard AI
    IF ccflag_cheat24 =. 1
        W32 guardAI 1
    EI
    IF ccflag_cheat24 =. 0
        W32 guardAI 0
    EI
    Call CheatToggle(0x12, ccflag_cheat24, ccflag_cheat24tgl)
    Call ToggleMask(guardAIStringEnd, ccflag_cheat24)

// ID 25: Dance Break
    IF ccflag_cheat25 =. 0
        WF 36B1B8 0
        WF 36B1BC 0.98491400
        WF 36B1C0 1.9891235
    EI
    IF ccflag_cheat25 =. 1
        WF 36B1B8 7
        WF 36B1BC 5.98
        WF 36B1C0 76.9899978
    EI
    Call CheatToggle(0x13, ccflag_cheat25, ccflag_cheat25tgl)
    Call ToggleMask(danceStringEnd, ccflag_cheat25)

// ID 26: Crash
    IF ccflag_cheat26 =. 1
        WP32 skybox,34 055677
        W32 36DBE8 12312312
        IF pad_Triangle =. 0xFF
            W32 36DBE4 12314477
        EI
    EI
    Call CheatToggle(0x14, ccflag_cheat26, ccflag_cheat26tgl)
    Call ToggleMask(skyboxStringEnd, ccflag_cheat26)

// ID 27: Time
    IF ccflag_cheat27 =. 1 && pad_Cross =. 0xFF
        Call Reload(full)
        W8 ccflag_cheat27 0
    EI
    Call CheatToggle(0x15, ccflag_cheat27, ccflag_cheat27tgl)
    IF tnHoverItem =. 21
        IF pad_DPadRight =. 0xFF && ccflag_timeScroll =. 0
            W8 ccflag_timeScroll 1
        EI

        IF pad_DPadLeft =. 0xFF && ccflag_timeScroll =. 1
            W8 ccflag_timeScroll 0
        EI
    EI
    Call SetTime(3, 23, 15, 22, 14) // venice
    Call SetTime(8, 14, 14, 15, 14) // australia (fix nighttime rain)
    Call SetTime(15, 15, 14, 14, 0x000175BD) // HOLLnd
    Call SetTime(23, 14, 14, 15, 14) // CHIN
    Call SetTime(31, 14, 14, 15, 14) // pirate

// ID 28: Toggle Skybox
    IF ccflag_cheat28 =. 1
        WP32 skybox,34 0
    EI
    IF ccflag_cheat28 =. 0
        WP32 skybox,34 0x501502F9
    EI
    Call CheatToggle(0x16, ccflag_cheat28, ccflag_cheat28tgl)
    Call ToggleMask(skyboxStringEnd, ccflag_cheat28)

// ID 29: Hide Flash
    IF ccflag_cheat29 =. 1 && tnStatus =: 0xFFFF
        WF hudScaleX 0
        WF hudScaleY 0
    EI
    IF ccflag_cheat29 =. 1 && tnStatus !: 0xFFFF
        WF hudScaleX 1
        WF hudScaleY 1
    EI
    IF ccflag_cheat29 =. 0 && tnStatus =: 0xFFFF
        WF hudScaleX 1
        WF hudScaleY 1
    EI
    Call CheatToggle(0x17, ccflag_cheat29, ccflag_cheat29tgl)
    Call ToggleMask(flashStringEnd, ccflag_cheat29)
