Function DamageType(character, offset, type)
    WP32 character,0xD4,offset type
EndFunction

Function Damage(character, offset, damage)
    WP16 character,0xD4,offset damage
EndFunction

Set warpCharString F1FAC
Set ccflag_warpTemp 36EBA3
Set ccflag_warpTemp2 36EBA4
Set ccflag_warpScroll 36EBA5

Function FillWarps(string, value, x, y, z)
    IF ccflag_warpScroll =. value
        WS warpCharString string
        IF pad_L3R3 =. 0xFD
            Call Teleport(x, y, z)
        EI
        IF tnHoverItem =. 6 && pad_Cross =. 0xFF
            Call Teleport(x, y, z)
        EI
    EI
EndFunction

Set currentMaxWarp 36EBA6
Function SetMaxWarps(map, max)
    IF mapID =. map && ccflag_warpScroll >. max
        W8 ccflag_warpScroll 0
    EI
    W8 currentMaxWarp max
    Set currentMax max
EndFunction