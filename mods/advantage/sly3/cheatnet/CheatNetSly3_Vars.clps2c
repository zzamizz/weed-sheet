Function MapUptimeCheck()
    IF mapUptime <: 0x3E
EndFunction

Function BuyBackwards(menuitem, ccflag, treasure)
    If tnHoverItem =. menuitem
        If pad_DPadRight =. 0xFF
            If ccflag =. 0
                W8 ccflag 1
                I8 treasure 1
            EndIf
        EndIf
        If pad_DPadRight !. 0xFF
            If ccflag =. 1
                W8 ccflag 0
            EndIf
        EndIf
    EndIf
EndFunction

Function Teleport(x, y, z)
    WF 34A380 x
    WF 34A384 y
    WF 34A388 z
    WP8 camera,reset 1
    W8 ccflag_zacTele 1
    W8 ccflag_zacCollider 1
    WF clockGame 0.01
EndFunction

Function MenuCombo(player) // remember to write EI after calling this
    If player =: 0xF7FE
EndFunction

Function ToggleGUI(gui, value)
    WP32 gui,0x54 value
EndFunction

Function CheatToggle(item, ccflag_cheat, ccflag_cheattgl)
    If tnStatus !: 0xFFFF
        If tnHoverItem =. item // when hovering a menu item
            If pad_Cross =. 0xFF && ccflag_cheattgl =. 0
                W8 ccflag_cheattgl 1
                I8 ccflag_cheat 1
            EI
            If pad_Cross !. 0xFF && ccflag_cheattgl =. 1
                W8 ccflag_cheattgl 0
            EI
            If ccflag_cheat =. 2
                W8 ccflag_cheat 0
            EI
        EI
    EI    
EndFunction

Function ToggleMask(stringend, cheat)
    IF cheat =. 1
        WB stringend "26 00 32 00 6D 00 26 00"
    EI
    IF cheat =. 0
        WB stringend "00"
    EI
EndFunction

Function FastScroll(val1, val2, val3)
    If tnStatus !: 0xFFFF
        If tnHoverItem =. val1
            If pad_Circle =. 0xFF
                W8 tnHoverItem val2
                W8 tnScroll val3
            EndIf
        EndIf
    EndIf
EndFunction

Function ShowCurrentMap(map, val)
    If mapID =. map && tnHoverItem !. 4
        W8 ccflag_mapNum val
    EndIf
EndFunction

Function LoadMap(val, string, aob)
    If ccflag_mapNum =. val
        WS F1FDA string
        If tnHoverItem =. 4
            CB aob mapValues 0x40
        EndIf
    EndIf
EndFunction

Set full 0xE
Set soft 0
Function Reload(bool)
    W32 reload 1
    W32 reloadFull bool
EndFunction

Set timeString F1F3C
Set ccflag_timeScroll 36E8B1
Function SetTime(map, mapDay, skyDay, mapNight, skyNight)
    IF mapID =. map 
        IF ccflag_timeScroll >. 1
            W8 ccflag_timeScroll 0
        EI
        IF ccflag_timeScroll =. 0
            WS timeString " Day\0"
            W32 mapTime mapDay
            W32 skyTime skyDay
        EI
        IF ccflag_timeScroll =. 1
            WS timeString " Night\0"
            W32 mapTime mapNight
            W32 skyTime skyNight
        EI
    EI
EndFunction

