// Open thiefnet with a flag (000F0000) (ty NiV-L-A)
ASM_START 001cb2c4
    j 0x000F1000
    nop
ASM_END
ASM_START 000F1000
    lui $t0,0x000F
    lb $t1,0x0($t0)
    li $at,1
    beq $t1,$at,call
    nop
    b ret
    nop
        call: sb $zero,0x0($t0)
        li $a0,0x46f810
        li $a1,0
        jal 0x0021ddc0
        nop
        li $a0,0x46f810
        li $a1,0
        jal 0x00220590
        nop
    ret: lui $v1,0x37 // og instruction
    lw $v0,-0x39b0($v1)
    j 0x001cb2cc
    nop
ASM_END

